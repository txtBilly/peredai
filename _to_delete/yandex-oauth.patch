@@ -0,0 +1,88 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { createClient, createAdminClient } from '@/lib/supabase/server';
+import { applyVerificationResult } from '@/lib/identity/apply';
+import { exchangeCodeForToken, fetchUserInfo, toVerificationResult } from '@/lib/identity/yandex';
+import { defaultLocale, isLocale } from '@/i18n/config';
+
+export const runtime = 'nodejs';
+
+// OAuth redirect target for Yandex ID (and, later, Sber ID / T-ID). The user's
+// browser lands here after authorizing. We validate the `state` against the
+// profile it was issued for, exchange the `code` for a token, read the user's
+// Yandex profile, and write the verification result — then send the user back
+// to the verify screen.
+export async function GET(req: NextRequest) {
+  const url = req.nextUrl;
+  const code = url.searchParams.get('code');
+  const state = url.searchParams.get('state');
+  const oauthError = url.searchParams.get('error');
+
+  const host = req.headers.get('x-forwarded-host') ?? req.headers.get('host');
+  const proto = req.headers.get('x-forwarded-proto') ?? (host?.includes('localhost') ? 'http' : 'https');
+  const appUrl = host ? `${proto}://${host}` : (process.env.NEXT_PUBLIC_APP_URL ?? 'http://localhost:3000');
+
+  const admin = createAdminClient();
+
+  // Resolve the user this state was issued for (set at /api/identity/start).
+  let userId: string | undefined;
+  let locale = defaultLocale as string;
+  if (state) {
+    const { data: profile } = await admin
+      .from('profiles')
+      .select('id, preferred_locale')
+      .eq('kyc_vendor_ref', state)
+      .maybeSingle();
+    userId = profile?.id;
+    if (profile?.preferred_locale && isLocale(profile.preferred_locale)) {
+      locale = profile.preferred_locale;
+    }
+  }
+
+  const backTo = (params: string) =>
+    NextResponse.redirect(`${appUrl}/${locale}/verify?return=1${params}`, 303);
+
+  // User denied, or the provider returned an error, or the state is unknown.
+  if (oauthError || !code || !state || !userId) {
+    if (userId && (oauthError || !code)) {
+      // An explicit denial/error → mark the attempt failed so the UI reflects it.
+      await applyVerificationResult(admin, userId, state ?? 'unknown', {
+        status: 'failed',
+        failureReason: oauthError ?? 'no_code',
+      });
+    }
+    return backTo(oauthError ? `&error=${encodeURIComponent(oauthError)}` : '');
+  }
+
+  // CSRF defense-in-depth: if a session is present, it must match the user the
+  // state was issued for. (The state itself is an unguessable per-user token.)
+  try {
+    const supabase = createClient();
+    const {
+      data: { user: sessionUser },
+    } = await supabase.auth.getUser();
+    if (sessionUser && sessionUser.id !== userId) {
+      return backTo('&error=session_mismatch');
+    }
+  } catch {
+    // No/invalid session cookie — fall through; state binding is the primary check.
+  }
+
+  try {
+    const token = await exchangeCodeForToken(code);
+    const info = await fetchUserInfo(token);
+    const result = toVerificationResult(info, state);
+    if (result.age == null) {
+      console.warn('[identity] Yandex returned no birthday — 18+ gate not enforced for', userId);
+    }
+    await applyVerificationResult(admin, userId, state, result);
+  } catch (e) {
+    console.error('[identity] Yandex callback failed', e);
+    await applyVerificationResult(admin, userId, state, {
+      status: 'failed',
+      failureReason: 'provider_error',
+    });
+    return backTo('&error=provider_error');
+  }
+
+  return backTo('');
+}
