# ============================================================
# Peredai environment variables — copy to .env.local and fill
# ============================================================

# ---- Supabase (self-hosted in Russia for 152-ФЗ; see docs/RU_DATA_RESIDENCY.md) ----
# Point these at your Russia-hosted Supabase stack (Yandex Cloud / VK / Selectel).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-ru-host.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ---- Payments: YooKassa (ЮKassa) ----
# From the YooKassa dashboard: Настройки → API-ключи
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=live_or_test_secret_key
# Price (whole rubles) for the 3-contact-credit bundle
CONTACT_BUNDLE_PRICE_RUB=1490

# ---- Identity: bank OAuth (Sber ID + T-ID). Yandex ID is NOT offered. ----
# Providers shown on the verify screen (comma-separated). "mock" = preview.
NEXT_PUBLIC_IDENTITY_PROVIDERS=mock       # mock  |  sber,tid
IDENTITY_REDIRECT_URL=http://localhost:3000/api/identity/callback
# Secret that hashes the bank identity (provider:sub) for one-account binding + bans.
IDENTITY_KEY_SECRET=change-me-to-a-long-random-secret
MOCK_KYC_RESULT=verified                  # mock outcome: verified | fail | underage

# Sber ID — from the Sber B2B portal after onboarding
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
# SBER_AUTHORIZE_URL= / SBER_TOKEN_URL= / SBER_USERINFO_URL=   # override for sandbox

# T-ID (T-Bank) — from the T-ID partner onboarding
TID_CLIENT_ID=
TID_CLIENT_SECRET=
# TID_AUTHORIZE_URL= / TID_TOKEN_URL= / TID_USERINFO_URL=      # override for sandbox

# ---- SMS (optional) ----
# Swap Twilio for a Russian SMS aggregator (SMSC.ru / SMS Aero) before launch.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+7XXXXXXXXXX

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@peredai.app

# ---- Protected endpoints ----
MODERATION_SECRET=random-secret
CRON_SECRET=random-secret
SITE_PASSCODE=preview-gate-passcode

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
